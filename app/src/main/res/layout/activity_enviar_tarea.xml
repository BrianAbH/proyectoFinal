<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloEnviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar tarea"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTipoEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tipo de entrega"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/contenedorTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Respuesta de texto"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTexto"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:hint="Escribe tu respuesta..."
                android:inputType="textMultiLine"
                android:padding="12dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorArchivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Archivo adjunto"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnArchivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Seleccionar archivo" />

            <TextView
                android:id="@+id/txtFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sin archivo seleccionado" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtErrorConfiguracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Esta tarea no tiene habilitado un tipo de entrega compatible."
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Enviar tarea" />

    </LinearLayout>

</ScrollView>